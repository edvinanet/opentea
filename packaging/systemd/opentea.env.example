# Copy this file to /etc/opentea/opentea.env and adjust for your deployment.
# Referenced by opentea.service's EnvironmentFile= (the leading "-" there
# means the service still starts if this file is missing, using the built-in
# defaults documented in README.md).
#
# This is systemd's mechanism (turns these into real process environment
# variables before exec); ../opentea.conf.example is the opentea binary's
# OWN config file mechanism (works regardless of how it's launched, not
# systemd-specific). You don't need both -- pick one. If you do use both,
# real environment variables (this file, once sourced by systemd) always
# win over opentea.conf's values.
#
# All variables are optional.

# Address the server listens on -- for the consumer-facing surface
# (/tea/v1 + /files), or for everything, if TEA_ADMIN_LISTEN_ADDR below is
# left unset. Port must stay >1024 (unprivileged) unless you also grant
# CAP_NET_BIND_SERVICE in opentea.service.
TEA_LISTEN_ADDR=:8080

# If set, binds a second, independent listener for the operator-facing
# surface (/admin/v1 + /admin/ui) separately from TEA_LISTEN_ADDR above --
# e.g. an internal-only interface/port for admin access while the consumer
# API stays reachable publicly. Leave unset for one listener serving
# everything, matching today's behavior.
#TEA_ADMIN_LISTEN_ADDR=127.0.0.1:8081

# Paths are relative to WorkingDirectory (/var/lib/opentea) if not absolute;
# spelled out here for clarity.
TEA_DB_PATH=/var/lib/opentea/opentea.db
TEA_BLOB_DIR=/var/lib/opentea/blobs

# This server's own public root URL -- used in discovery responses and
# generated file URLs. Update once you know the real hostname/scheme this
# server will be reached at.
TEA_ROOT_URL=http://localhost:8080

# Comma-separated list of supported TEA API versions, reported by discovery.
TEA_VERSIONS=0.4.0

# Organisation name, shown in the admin GUI and in GET /admin/v1/stats.
TEA_ORG_NAME=

# TLS: if both are set, the server listens with HTTPS instead of plain HTTP.
#TEA_TLS_CERT_FILE=/etc/opentea/tls/cert.pem
#TEA_TLS_KEY_FILE=/etc/opentea/tls/key.pem
